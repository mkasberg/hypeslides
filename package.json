{
  "name": "hypeslides",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "test:e2e": "tools/playwright-docker.sh --project=chromium",
    "test:e2e:update": "tools/playwright-docker.sh --project=chromium --update-snapshots",
    "test:e2e:local": "playwright test --project=chromium",
    "parity": "tools/playwright-docker.sh --project=parity",
    "parity:update": "PARITY_UPDATE=1 tools/playwright-docker.sh --project=parity",
    "parity:refresh": "tools/parity-refresh.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@lezer/highlight": "^1.2.5",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "pdfjs-dist": "^6.4.299",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "ssim.js": "^3.5.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
